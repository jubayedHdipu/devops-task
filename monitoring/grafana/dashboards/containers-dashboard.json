{
    "uid": "devops-containers-dash",
    "title": "Container Resource Metrics (cAdvisor)",
    "tags": [
        "devops-task",
        "containers"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "15s",
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Container CPU Usage (cores)",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[2m])) by (name)",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Container Memory Usage (Bytes)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                }
            },
            "targets": [
                {
                    "expr": "container_memory_working_set_bytes{name!=\"\"}",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Container Memory Usage (% of Configured Limit)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                }
            },
            "targets": [
                {
                    "expr": "(container_memory_working_set_bytes{name!=\"\"} / container_spec_memory_limit_bytes{name!=\"\"}) * 100",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ]
        }
    ]
}